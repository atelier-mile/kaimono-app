.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated iOS folder (Android sources are kept for reproducible builds)
/ios

# Local IDE settings and development records
/.vscode/
/docs/*
!/docs/開発履歴.md
!/docs/共有用/
/docs/共有用/*
!/docs/共有用/作業履歴.md
!/docs/共有用/GitHub初回送信報告書.md

# Android machine-specific settings and generated output
/android/.gradle/
/android/.idea/
/android/.kotlin/
/android/build/
/android/app/build/
/android/app/.cxx/
/android/local.properties
/android/gradle/*.bak
*.iml
*.hprof

# Local signing properties (never commit credential values)
/signing.properties
/keystore.properties
/android/signing.properties
/android/keystore.properties
/android/key.properties
/android/app/keystore.properties

# Packaged output, temporary files and logs
*.apk
*.aab
*.log
*.tmp
*.temp

# Unused template images (keep the local files)
/assets/images/react-logo.png
/assets/images/react-logo@2x.png
/assets/images/react-logo@3x.png
/assets/images/tutorial-web.png

# Local secrets and generated files (Git/GitHub safety audit)
*.keystore
*.pfx
*.dpapi
.env
.env.*
/.gradle-user/
/emulator.log
/emulator-error.log
/metro-local.log
/credentials.json
/service-account*.json
/backup/
